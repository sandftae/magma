# ============================================================
# STEP ID: services
# DESCRIPTION: configuration for additional services selection
# ============================================================

# the header title
SERVICES_MENU_TITLE="ADDITIONAL SERVICES"

# service menu dialog window hegiht
SERVICE_MENU_HEIGHT=17

# service menu dialog window width
SERVCIES_DIALOG_WIDTH=70

# services list: ID | Description | Default Status (ON/OFF)
SERVICES_LIST=(
    "rabbitmq"      "RabbitMQ                   [Recommended]"      "ON"
    "phpmyadmin"    "phpMyAdmin                 [Recommended]"      "ON"
    "mailpit"       "MailPit                    [Recommended]"      "ON"
    "dozzle"        "Dozzle (container logs)    [Recommended]"      "ON"
    "os_dash"       "OpenSearch Dashboard"                          "OFF"
    "grafana"       "Grafana Monitoring"                            "OFF"
)

# dialog window and meta data configuration
SERVICES_TOTAL_MESSAGE="Select one or more services to add to your environment.\nUse SPACE to toggle."

# dialog window and meta data configuration for gum
SERVICES_TOTAL_MESSAGE_GUM='
   {{ " " }}
   {{ Color "10" "Select services to include:" }}
   {{ " " }}
   {{ " " }}
'