# the header title
SERVICES_MENU_TITLE="SERVICES"

# service menu dialog window hegiht
SERVICE_MENU_HEIGHT=17

# service menu dialog window width
SERVCIES_DIALOG_WIDTH=70

# services list: ID | Description | Default Status (ON/OFF)
SERVICES_LIST=(
    "rabbitmq"      "RabbitMQ                     ${COLOR_GREEN}${COLOR_BOLD}[Recommended]${COLOR_NORMAL}"  "ON"
    "phpmyadmin"    "phpMyAdmin                   ${COLOR_GREEN}${COLOR_BOLD}[Recommended]${COLOR_NORMAL}"  "ON"
    "mailpit"       "MailPit                      ${COLOR_GREEN}${COLOR_BOLD}[Recommended]${COLOR_NORMAL}"  "ON"
    "dozzle"        "Dozzle (container logs)      ${COLOR_GREEN}${COLOR_BOLD}[Recommended]${COLOR_NORMAL}"  "ON"
    "os_dash"       "OpenSearch Dashboard         ${COLOR_CYAN}${COLOR_BOLD}[Optional]${COLOR_NORMAL}"     "OFF"
    "grafana"       "Grafana Monitoring           ${COLOR_CYAN}${COLOR_BOLD}[Optional]${COLOR_NORMAL}"     "OFF"
    "prometheus"    "Prometheus Monitoring        ${COLOR_CYAN}${COLOR_BOLD}[Optional]${COLOR_NORMAL}"     "OFF"
    "cadvisor"      "cAdvisor (container metrics) ${COLOR_CYAN}${COLOR_BOLD}[Optional]${COLOR_NORMAL}"     "OFF"
)

# services list: ID | Description | Default Status (ON/OFF)
SERVICES_LIST_GUM=(
    "rabbitmq"      "RabbitMQ                     [Recommended]"  "ON"
    "phpmyadmin"    "phpMyAdmin                   [Recommended]"  "ON"
    "mailpit"       "MailPit                      [Recommended]"  "ON"
    "dozzle"        "Dozzle (container logs)      [Recommended]"  "ON"
    "os_dash"       "OpenSearch Dashboard         [Optional]"     "OFF"
    "grafana"       "Grafana Monitoring           [Optional]"     "OFF"
    "prometheus"    "Prometheus Monitoring        [Optional]"     "OFF"
    "cadvisor"      "cAdvisor (container metrics) [Optional]"     "OFF"
)

