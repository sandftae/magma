    "mailpit"       "MailPit                [Recommended]"  "ON"
    "dozzle"        "Dozzle                 [Recommended]"  "ON"
    "os_dash"       "OpenSearch Dashboard   [Optional]"     "OFF"
    "grafana"       "Grafana                [Optional]"     "OFF"
    "prometheus"    "Prometheus             [Optional]"     "OFF"
