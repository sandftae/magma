# ============================================================
# STEP ID: domain
# DESCRIPTION: configuration for the project domain setup
# ============================================================

# domain specific title
DOMAIN_MENU_TITLE='PROJECT DOMAIN CONFIGURATION'

# default value
DOMAIN_DEFAULT_VALUE='mage-dev.localhost'

# tooltip/help message for the input box
DOMAIN_DIALOG_TOOLTIP="Please enter a local development domain (e.g., myapp.localhost)"

# UI dettings
DOMAIN_DIALOG_HEIGHT=15
DOMAIN_DIALOG_WIDTH=65

# help window settings
DOMAIN_HELP_TITLE='DOMAIN EXAMPLES'
DOMAIN_MENU_BOX_CONTENT="\n
These are examples of ${COLOR_CYAN}${COLOR_BOLD}valid${COLOR_NORMAL} domains:\n
    - ${COLOR_YELLOW}${COLOR_BOLD}mage-dev.localhost${COLOR_NORMAL}\n
    - ${COLOR_YELLOW}${COLOR_BOLD}website.localhost${COLOR_NORMAL}\n
    - ${COLOR_YELLOW}${COLOR_BOLD}api.service.localhost${COLOR_NORMAL}\n
    - ${COLOR_YELLOW}${COLOR_BOLD}app.localhost${COLOR_NORMAL}\n\n

Note: must end with ${COLOR_YELLOW}${COLOR_BOLD}.localhost${COLOR_NORMAL}\n\n
"

# 'Back' label
DOMAIN_BACK_LABEL='Back'